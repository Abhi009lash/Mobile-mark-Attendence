{
  "expo": {
    "name": "Geopoint",
    "slug": "geopoint",
    "scheme": "geopoint",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.geopoint.attendance"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1657DE",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.geopoint.attendance"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
