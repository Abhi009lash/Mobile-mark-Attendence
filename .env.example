# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Mobile Attendance SaaS"
API_V1_STR="/api/v1"

# Security & JWT Tokens
# JWT Access Token lifetime: 15 minutes (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh Token lifetime: 90 days (in days)
REFRESH_TOKEN_EXPIRE_DAYS=90
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production_attendance_jwt_secret_key_2026
JWT_ALGORITHM=HS256

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=attendance_db
# Set DATABASE_URL or let config assemble it from POSTGRES_*
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/attendance_db

# Redis (Token blacklisting, Rate limiting, Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Frontend API Base URL (Expo public environment variable)
EXPO_PUBLIC_API_URL=http://192.168.0.4:8000/api/v1

# CORS Origins (comma separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","http://localhost:19006","http://localhost:8000","*"]

# SMTP Email Configuration
# Set EMAILS_ENABLED=true when live SMTP credentials (e.g. Gmail App Password, SendGrid, SES) are configured
EMAILS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@geopoint.io
SMTP_FROM_NAME="Geopoint Security"
SMTP_TLS=true
SMTP_SSL=false
